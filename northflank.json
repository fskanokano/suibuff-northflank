{
  "apiVersion": "v1",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Workflow",
          "spec": {
            "type": "parallel",
            "steps": [
              {
                "kind": "BuildService",
                "ref": "suibuff",
                "spec": {
                  "name": "suibuff",
                  "tags": [],
                  "billing": {
                    "deploymentPlan": "nf-compute-20"
                  },
                  "vcsData": {
                    "projectUrl": "https://github.com/fskanokano/suibuff-northflank",
                    "projectType": "github"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "kaniko",
                      "dockerFilePath": "/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "buildConfiguration": {},
                  "disabledCI": false,
                  "buildArguments": {}
                }
              }
            ]
          }
        },
        {
          "kind": "Build",
          "spec": {
            "type": "service",
            "id": "suibuff",
            "branch": "main"
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "suibuff",
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "suibuff",
                "branch": "main",
                "buildSHA": "latest"
              }
            },
            "billing": {
              "deploymentPlan": "nf-compute-20"
            },
            "ports": [
              {
                "name": "http",
                "internalPort": 3457,
                "public": true,
                "protocol": "HTTP",
                "security": {
                  "credentials": [],
                  "policies": []
                },
                "domains": [],
                "disableNfDomain": false
              }
            ],
            "runtimeEnvironment": {}
          }
        }
      ]
    }
  },
  "name": "suibuff-northflank",
  "description": "freebuff-proxy (Go OpenAI-compatible gateway) adapted for Northflank — deploy from GitHub repo with zero source changes.",
  "project": {
    "id": "suibuff-northflank"
  },
  "$schema": "https://api.northflank.com/v1/schemas/template"
}

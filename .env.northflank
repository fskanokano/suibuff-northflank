# ==============================================================================
# suibuff-northflank — freebuff-proxy on Northflank
#
# Environment variables required / recommended for Northflank deployment.
# Set these in the Northflank console: Service → Configuration → Environment.
#
# Copy values you need; the two marked [REQUIRED] are mandatory on the cloud.
# ==============================================================================

# ── [REQUIRED] Listening address ──────────────────────────────────────────
# Upstream default is 127.0.0.1:3457 (loopback only — reachable from the
# container itself but NOT from Northflank's ingress). Bind all interfaces
# so the platform's HTTPS entrypoint can forward to the service.
LISTEN_ADDR=:3457

# ── [REQUIRED] CLI token auto-discovery ───────────────────────────────────
# This knob is ENV-ONLY (it controls whether .env / CLI login files are read
# at all). Northflank has no ~/.config/codebuff credentials, so disable it
# to prevent bridge mode silently flipping to pooled mode with an empty pool.
AUTO_DISCOVER_TOKEN=false

# ── Mode (the only real decision) ─────────────────────────────────────────
# Comma-separated upstream FreeBuff token(s). EMPTY = bridge mode:
# the proxy stores no tokens; each client sends its own in
# Authorization: Bearer <token>. Pooled mode (tokens listed here) is best
# for one user with several accounts.
AUTH_TOKENS=

# ── Account safety (anti-ban) ────────────────────────────────────────────
# SAFE_MODE=true applies the anti-ban preset when a knob is left unset.
# Keep this ON.
SAFE_MODE=true

# Browser TLS fingerprint: auto | chrome120 | chrome126 | safari17 |
# safari18 | firefox120 | firefox128 | edge126 | random.
TLS_FINGERPRINT=auto

# Random delay in [0, REQUEST_JITTER) before each upstream chat call.
# 2s under SAFE_MODE; 0 disables.
REQUEST_JITTER=2s

# Pause run rotation / session refresh after this idle period.
# 30m under SAFE_MODE; 0 disables.
IDLE_ROTATION_TIMEOUT=30m

# ── Cost safety ──────────────────────────────────────────────────────────
# MUST stay "free": any other value routes requests as PAID and fresh free
# accounts get 402 "Out of credits". Do not change this.
COST_MODE=free

# ── Admin dashboard protection ────────────────────────────────────────────
# STRONGLY recommended on a public URL:
#   openssl rand -hex 16
ADMIN_TOKEN=

# ── Optional client auth for the OpenAI-compatible endpoint ───────────────
# When set, only requests bearing one of these keys (Authorization: Bearer
# or x-api-key) are served; leave empty to skip client auth.
#API_KEYS=

# ── Observability ────────────────────────────────────────────────────────
LOG_LEVEL=info
